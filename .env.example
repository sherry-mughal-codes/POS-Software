# -----------------------------------------------------------------------------
# Point of Sale (POS) System - Environment Configuration Template
# -----------------------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_secure_password_123!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Backend Configuration
DJANGO_SECRET_KEY=django-insecure-pos-dev-secret-key-change-in-production-^9x7$!2k
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# CORS Configuration (Frontend URLs allowed to query Backend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="ApexPOS Enterprise"
